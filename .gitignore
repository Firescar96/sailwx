__pycache__/
*.pyc
.DS_Store

# The live weather database and its backups are local runtime data, not
# source -- schema.sql + the ingestion scripts fully reproduce the schema
# and data pipeline; the actual data is regenerated continuously by cron.
db/weather.duckdb
backups/

# Local exported CSVs (also runtime data, regenerated by the ingesters).
data/*.csv

# TLS private key/cert material must never be committed (found and
# removed a leftover pair here before the first commit -- see project
# history/README for the Tailscale HTTPS setup instead).
*.key
*.crt

# Editor/OS cruft
.vscode/
*.swp
*.deb
